<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:BearMinVLC.Controls"
             x:Class="BearMinVLC.Views.PlayerView"
             FontFamily="{StaticResource Geist}"
             Foreground="{StaticResource Text}"
             Background="Transparent">

  <!--
    Everything here lives in LibVLCSharp's overlay window, stacked over the native video surface.
    Layers, bottom to top: video gestures → audio-only/end → control chrome → OSD/toast →
    start & error screens → title row → menus → dialogs → drop target → resize strip.
  -->
  <Grid x:Name="Root" Background="Transparent">

    <!-- Clicks, drags, wheel and right-click on the video itself -->
    <Border x:Name="Tap" Background="Transparent" />

    <!-- Audio-only files: the mark and the title instead of a black frame -->
    <StackPanel x:Name="AudioOnlyLayer" IsVisible="False" IsHitTestVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
      <Viewbox Width="96" Height="96">
        <Canvas Width="32" Height="32">
          <Path Fill="{StaticResource Accent}" Data="{StaticResource LogoHead}" />
          <Path Fill="{StaticResource Ground}" Data="{StaticResource LogoPlay}" />
        </Canvas>
      </Viewbox>
      <TextBlock x:Name="AudioTitle" FontSize="15" FontWeight="Medium" HorizontalAlignment="Center" />
    </StackPanel>

    <!-- End of video -->
    <Grid x:Name="EndLayer" IsVisible="False" Background="#990C0B0A">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Margin="20,0,20,60">
        <TextBlock x:Name="EndTitle" FontSize="14" Foreground="{StaticResource MutedOnVideo}"
                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
          <Button x:Name="ReplayButton" Classes="primary" Padding="18,0,22,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Viewbox Width="18" Height="18">
                <Path Classes="icon" Data="{StaticResource IcBack}" Stroke="{StaticResource Ground}" StrokeThickness="2" />
              </Viewbox>
              <TextBlock Text="Replay" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="EndOpenButton" Classes="ghost" Content="Open another" BorderBrush="#33FFFFFF" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- Brief play/pause flash after a click on the video -->
    <Border x:Name="CenterFlash" Width="72" Height="72" CornerRadius="36" Background="#8C000000"
            HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.35" />
        </Transitions>
      </Border.Transitions>
      <Viewbox Width="32" Height="32">
        <Path x:Name="CenterFlashIcon" Classes="icon fill" Data="{StaticResource IcPause}" />
      </Viewbox>
    </Border>

    <!-- Loading spinner (shown only after 0.4 s) -->
    <Path x:Name="Spinner" Classes="spin" IsVisible="False" IsHitTestVisible="False"
          Width="40" Height="40" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
          Stroke="{StaticResource Text}" StrokeThickness="3" StrokeLineCap="Round"
          Data="M20 4 A16 16 0 0 1 36 20" RenderTransformOrigin="50%,50%">
      <Path.RenderTransform>
        <RotateTransform />
      </Path.RenderTransform>
    </Path>

    <!-- Thin progress line while the controls are hidden -->
    <Panel x:Name="HiddenProgress" VerticalAlignment="Bottom" Height="24" IsHitTestVisible="False" Opacity="0">
      <Panel.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        </Transitions>
      </Panel.Transitions>
      <Border>
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
            <GradientStop Offset="0" Color="#73000000" />
            <GradientStop Offset="1" Color="#00000000" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Border x:Name="HiddenProgressTrack" Height="3" VerticalAlignment="Bottom" Background="#47FFFFFF">
        <Border x:Name="HiddenProgressFill" HorizontalAlignment="Left" Width="0" Background="{StaticResource Accent}" />
      </Border>
    </Panel>

    <!-- Control chrome: top scrim + bottom bar. Fades together. -->
    <Panel x:Name="Chrome">
      <Panel.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        </Transitions>
      </Panel.Transitions>

      <Border x:Name="TopScrim" Height="96" VerticalAlignment="Top" IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#B8000000" />
            <GradientStop Offset="0.35" Color="#99000000" />
            <GradientStop Offset="1" Color="#00000000" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <Border x:Name="BottomBar" VerticalAlignment="Bottom" Padding="20,48,20,12">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
            <GradientStop Offset="0" Color="#CC000000" />
            <GradientStop Offset="0.35" Color="#B8000000" />
            <GradientStop Offset="0.6" Color="#73000000" />
            <GradientStop Offset="0.85" Color="#26000000" />
            <GradientStop Offset="1" Color="#00000000" />
          </LinearGradientBrush>
        </Border.Background>
        <StackPanel>
          <!-- 32 px tall so it's easy to grab; the visible track is 6 px (8 px under the pointer) -->
          <c:SeekBar x:Name="Seek" Height="32" />
          <Grid ColumnDefinitions="*,Auto" Margin="-16,0,-14,0">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,16,0">
                <Button x:Name="PlayPauseButton" Classes="icon" AutomationProperties.Name="Pause">
                  <Path x:Name="PlayPauseIcon" Classes="icon fill" Data="{StaticResource IcPause}" />
                </Button>
                <Button x:Name="BackButton" Classes="icon" AutomationProperties.Name="Back 10 seconds">
                  <Grid Width="24" Height="24">
                    <Path Classes="icon" Data="{StaticResource IcBack}" />
                    <TextBlock x:Name="BackLabel" Text="10" FontSize="7" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0" />
                  </Grid>
                </Button>
                <Button x:Name="ForwardButton" Classes="icon" AutomationProperties.Name="Forward 10 seconds">
                  <Grid Width="24" Height="24">
                    <Path Classes="icon" Data="{StaticResource IcFwd}" />
                    <TextBlock x:Name="ForwardLabel" Text="10" FontSize="7" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0" />
                  </Grid>
                </Button>
              </StackPanel>
              <Button x:Name="TimeButton" Classes="time" AutomationProperties.Name="Elapsed time. Click to show time remaining">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="TimeNow" Text="0:00" FontSize="13" FontWeight="Medium" FontFeatures="+tnum" />
                  <TextBlock x:Name="TimeTotal" Text=" / 0:00" FontSize="13" FontWeight="Medium" FontFeatures="+tnum"
                             Foreground="{StaticResource MutedOnVideo}" />
                </StackPanel>
              </Button>
            </WrapPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,0">
                <Button x:Name="MuteButton" Classes="icon" AutomationProperties.Name="Mute">
                  <Path x:Name="MuteIcon" Classes="icon" Data="{StaticResource IcVolume}" />
                </Button>
                <c:MiniSlider x:Name="VolumeSlider" Width="88" Height="20" VerticalAlignment="Center" />
              </StackPanel>
              <Button x:Name="TracksButton" Classes="icon" AutomationProperties.Name="Subtitles and audio">
                <Path Classes="icon" Data="{StaticResource IcSubtitles}" />
              </Button>
              <Button x:Name="SpeedButton" Classes="icon" Padding="8,0" AutomationProperties.Name="Playback speed, normal">
                <TextBlock x:Name="SpeedText" Text="1×" FontSize="13" FontWeight="Medium" FontFeatures="+tnum" />
              </Button>
              <Button x:Name="FullscreenButton" Classes="icon" AutomationProperties.Name="Enter fullscreen">
                <Path x:Name="FullscreenIcon" Classes="icon" Data="{StaticResource IcFullscreen}" />
              </Button>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </Panel>

    <!-- OSD pill: volume, seek, speed, delays -->
    <Border x:Name="Osd" Classes="pill" Padding="16,10" Margin="0,28,0,0" IsHitTestVisible="False"
            HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        </Transitions>
      </Border.Transitions>
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Viewbox x:Name="OsdIconBox" Width="20" Height="20">
          <Path x:Name="OsdIcon" Classes="icon" StrokeThickness="1.8" Data="{StaticResource IcVolume}" />
        </Viewbox>
        <Border x:Name="OsdBar" Width="120" Height="4" CornerRadius="2" Background="#47FFFFFF" VerticalAlignment="Center">
          <Border x:Name="OsdBarFill" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource Text}" Width="0" />
        </Border>
        <TextBlock x:Name="OsdText" FontSize="13" FontWeight="Medium" FontFeatures="+tnum" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Start screen -->
    <Grid x:Name="StartLayer" Background="{StaticResource Ground}" RowDefinitions="32,*,Auto">
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel VerticalAlignment="Center" Spacing="48" Margin="20,16">
          <StackPanel HorizontalAlignment="Center" Spacing="14" MaxWidth="560">
            <Viewbox Width="56" Height="56" HorizontalAlignment="Center">
              <Canvas Width="32" Height="32">
                <Path Fill="{StaticResource Accent}" Data="{StaticResource LogoHead}" />
                <Path Fill="{StaticResource Ground}" Data="{StaticResource LogoPlay}" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="Drop a video here" FontSize="28" FontWeight="SemiBold" LetterSpacing="-0.56"
                       HorizontalAlignment="Center" Margin="0,6,0,0" />
            <TextBlock Text="Or open one from your computer. MKV, MP4, AVI, MOV, WebM — just about anything plays."
                       FontSize="15" LineHeight="22" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       TextAlignment="Center" MaxWidth="380" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,10,0,0">
              <Button x:Name="OpenFileButton" Classes="primary">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Open file" VerticalAlignment="Center" />
                  <TextBlock Text="Ctrl O" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="OpenUrlButton" Classes="ghost" Content="Open URL" />
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="RecentSection" Spacing="2" MaxWidth="560">
            <Grid ColumnDefinitions="*,Auto" Margin="8,0,0,6">
              <TextBlock Text="Recent" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
              <Button x:Name="ClearRecentButton" Grid.Column="1" Classes="link" Content="Clear" />
            </Grid>
            <StackPanel x:Name="RecentList" Spacing="2" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center" Margin="20,12,20,16">
        <Button x:Name="StartSettingsButton" Classes="link" Height="32">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Viewbox Width="14" Height="14">
              <Path Classes="icon" Data="{StaticResource IcSliders}" Stroke="{StaticResource Muted}" StrokeThickness="2" />
            </Viewbox>
            <TextBlock Text="Settings" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <StackPanel x:Name="ShortcutHint" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="Press" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
          <Border Classes="kbd"><TextBlock Text="?" /></Border>
          <TextBlock Text="for keyboard shortcuts" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- In-window errors -->
    <Grid x:Name="ErrorLayer" IsVisible="False" Background="{StaticResource Ground}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Margin="20,24,20,64" MaxWidth="460">
        <Viewbox Width="40" Height="40" HorizontalAlignment="Center">
          <Path Classes="icon" Data="{StaticResource IcAlert}" Stroke="{StaticResource Muted}" />
        </Viewbox>
        <TextBlock x:Name="ErrorTitle" FontSize="28" FontWeight="SemiBold" LetterSpacing="-0.56"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
        <TextBlock x:Name="ErrorBody" FontSize="15" LineHeight="22" Foreground="{StaticResource Muted}"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" HorizontalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,10,0,0">
          <Button x:Name="ErrorPrimary" Classes="primary" />
          <Button x:Name="ErrorSecondary" Classes="ghost" />
        </StackPanel>
        <Button x:Name="ErrorDetailsButton" Classes="link" Height="36" HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Technical details" VerticalAlignment="Center" />
            <Viewbox Width="14" Height="14">
              <Path Classes="icon" Data="{StaticResource IcChevronDown}" Stroke="{StaticResource Muted}" StrokeThickness="2" />
            </Viewbox>
          </StackPanel>
        </Button>
        <SelectableTextBlock x:Name="ErrorDetails" IsVisible="False" FontFamily="{StaticResource GeistMono}" FontSize="11"
                             Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- Toast ("Resumed at 12:48 · Start over", "Recent list cleared · Undo") -->
    <Border x:Name="Toast" Classes="pill" Padding="16,4,4,4" Margin="0,48,0,0" IsVisible="False"
            HorizontalAlignment="Center" VerticalAlignment="Top">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock x:Name="ToastText" FontSize="14" FontFeatures="+tnum" VerticalAlignment="Center" />
        <Button x:Name="ToastAction" Classes="link amber" />
      </StackPanel>
    </Border>

    <!-- Title row: filename + window buttons. Plain on the start screen, over a scrim on video. -->
    <Grid x:Name="TitleRow" Height="32" VerticalAlignment="Top" ColumnDefinitions="*,Auto">
      <Grid.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        </Transitions>
      </Grid.Transitions>
      <Border x:Name="DragArea" Background="Transparent">
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="20,0,0,0" VerticalAlignment="Center">
          <Viewbox Width="18" Height="18">
            <Canvas Width="32" Height="32">
              <Path Fill="{StaticResource Accent}" Data="{StaticResource LogoHead}" />
              <Path Fill="{StaticResource Ground}" Data="{StaticResource LogoPlay}" />
            </Canvas>
          </Viewbox>
          <TextBlock x:Name="TitleText" Text="BearMinVLC" FontSize="12" FontWeight="Medium"
                     Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="MinButton" Classes="caption" AutomationProperties.Name="Minimize">
          <Path Classes="cap" Data="{StaticResource CapMin}" />
        </Button>
        <Button x:Name="MaxButton" Classes="caption" AutomationProperties.Name="Maximize">
          <Path x:Name="MaxIcon" Classes="cap" Data="{StaticResource CapMax}" />
        </Button>
        <Button x:Name="CloseButton" Classes="caption close" AutomationProperties.Name="Close">
          <Path Classes="cap" Data="{StaticResource CapClose}" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- Menus. The transparent layer closes them on an outside click. -->
    <Panel x:Name="MenuLayer" IsVisible="False" Background="Transparent">
      <Border x:Name="TracksMenu" Classes="panel" Width="300" MaxHeight="420" Padding="8" IsVisible="False"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,96">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="TracksList" Spacing="2" />
        </ScrollViewer>
      </Border>
      <Border x:Name="SpeedMenu" Classes="panel" Width="168" Padding="8" IsVisible="False"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,96">
        <StackPanel x:Name="SpeedList" Spacing="2" />
      </Border>
      <Border x:Name="ContextMenuPanel" Classes="panel" Width="248" Padding="6" IsVisible="False"
              HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel x:Name="ContextList" Spacing="2" />
      </Border>
    </Panel>

    <!-- Dialogs -->
    <Grid x:Name="DialogLayer" IsVisible="False" Background="#8C000000">
      <Border x:Name="UrlDialog" IsVisible="False" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
              BorderThickness="1" CornerRadius="20" Padding="24" MaxWidth="480" Margin="20"
              BoxShadow="0 24 60 0 #8C000000" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="Open URL" FontSize="15" FontWeight="Medium" />
          <StackPanel Spacing="8">
            <TextBlock Text="Stream or video address" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Muted}" />
            <TextBox x:Name="UrlBox" Classes="url" PlaceholderText="https://…" AutomationProperties.Name="Stream or video address" />
            <TextBlock x:Name="UrlHint" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="HTTP, HLS, RTSP and most other streams work." />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="UrlCancel" Classes="ghost small" Content="Cancel" Padding="18,0" />
            <Button x:Name="UrlOpen" Classes="primary small" Content="Open" Padding="20,0" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="KeysSheet" IsVisible="False" Classes="panel" CornerRadius="20" Padding="28,28,28,24"
              MaxWidth="860" Margin="24" Background="#F01A1917" BoxShadow="0 24 60 0 #8C000000" VerticalAlignment="Center">
        <StackPanel Spacing="20">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Keyboard shortcuts" FontSize="15" FontWeight="Medium" VerticalAlignment="Center" />
            <Button x:Name="KeysClose" Grid.Column="1" Classes="icon" Width="36" MinWidth="36" Height="36" AutomationProperties.Name="Close">
              <Viewbox Width="16" Height="16">
                <Path Classes="icon" Data="{StaticResource IcClose}" Stroke="{StaticResource Muted}" StrokeThickness="2" />
              </Viewbox>
            </Button>
          </Grid>
          <Grid x:Name="KeysGrid" ColumnDefinitions="*,32,*,32,*" />
          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <TextBlock FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="Mouse: click the video to pause · double-click for fullscreen · scroll for volume · right-click for more." />
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Settings -->
    <Grid x:Name="SettingsLayer" IsVisible="False" Background="#8C000000">
      <Border x:Name="SettingsSheet" Classes="panel" CornerRadius="20" Padding="28,24,28,20" MaxWidth="880" Margin="24"
              Background="#F51A1917" BoxShadow="0 24 60 0 #8C000000" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Settings" FontSize="15" FontWeight="Medium" VerticalAlignment="Center" />
            <Button x:Name="SettingsClose" Grid.Column="1" Classes="icon" Width="36" MinWidth="36" Height="36" AutomationProperties.Name="Close settings">
              <Viewbox Width="16" Height="16">
                <Path Classes="icon" Data="{StaticResource IcClose}" Stroke="{StaticResource Muted}" StrokeThickness="2" />
              </Viewbox>
            </Button>
          </Grid>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,-12,0" Padding="0,0,12,0">
            <Grid x:Name="SettingsColumns" ColumnDefinitions="*,40,*" RowDefinitions="Auto,Auto">
              <StackPanel x:Name="SettingsLeft">
                <TextBlock Classes="section" Text="Playback" />
                <Grid Classes="setting" ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                    <TextBlock Classes="label" Text="Resume where you left off" />
                    <TextBlock Classes="hint" Text="From 30 s in to 95% through." />
                  </StackPanel>
                  <ToggleSwitch x:Name="ResumeToggle" Grid.Column="1" AutomationProperties.Name="Resume where you left off" />
                </Grid>
                <Grid Classes="setting" ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                    <TextBlock Classes="label" Text="Skip length" />
                    <TextBlock Classes="hint" Text="Skip buttons and ← → keys." />
                  </StackPanel>
                  <Border Classes="seg" Grid.Column="1"><StackPanel x:Name="SkipChoices" Orientation="Horizontal" Spacing="2" /></Border>
                </Grid>

                <TextBlock Classes="section" Text="Video" />
                <Grid Classes="setting" ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                    <TextBlock Classes="label" Text="Hardware decoding" />
                    <TextBlock Classes="hint" Text="Turn off if a video stutters or shows glitches." />
                  </StackPanel>
                  <ToggleSwitch x:Name="HwToggle" Grid.Column="1" AutomationProperties.Name="Hardware decoding" />
                </Grid>
                <Grid Classes="setting" ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                    <TextBlock Classes="label" Text="Deinterlacing" />
                    <TextBlock Classes="hint" Text="For old TV recordings with comb-like lines." />
                  </StackPanel>
                  <Border Classes="seg" Grid.Column="1"><StackPanel x:Name="DeinterlaceChoices" Orientation="Horizontal" Spacing="2" /></Border>
                </Grid>
              </StackPanel>

              <StackPanel x:Name="SettingsRight" Grid.Column="2">
                <TextBlock Classes="section" Text="Subtitles" />
                <Grid Classes="setting" ColumnDefinitions="*,Auto">
                  <TextBlock Classes="label" Text="Size" VerticalAlignment="Center" Margin="0,0,16,0" />
                  <Border Classes="seg" Grid.Column="1"><StackPanel x:Name="SubSizeChoices" Orientation="Horizontal" Spacing="2" /></Border>
                </Grid>
                <Grid Classes="setting" ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                    <TextBlock Classes="label" Text="Position" />
                    <TextBlock Classes="hint" Text="Keep them clear of the controls." />
                  </StackPanel>
                  <Border Classes="seg" Grid.Column="1"><StackPanel x:Name="SubPositionChoices" Orientation="Horizontal" Spacing="2" /></Border>
                </Grid>
                <Grid Classes="setting" ColumnDefinitions="*,Auto">
                  <TextBlock Classes="label" Text="Preferred language" VerticalAlignment="Center" Margin="0,0,16,0" />
                  <ComboBox x:Name="SubLanguageBox" Grid.Column="1" Classes="setting" AutomationProperties.Name="Preferred subtitle language" />
                </Grid>

                <TextBlock Classes="section" Text="Audio" />
                <Grid Classes="setting" ColumnDefinitions="*,Auto">
                  <TextBlock Classes="label" Text="Preferred language" VerticalAlignment="Center" Margin="0,0,16,0" />
                  <ComboBox x:Name="AudioLanguageBox" Grid.Column="1" Classes="setting" AutomationProperties.Name="Preferred audio language" />
                </Grid>
                <Grid Classes="setting" ColumnDefinitions="*,Auto">
                  <TextBlock Classes="label" Text="Output device" VerticalAlignment="Center" Margin="0,0,16,0" />
                  <ComboBox x:Name="AudioDeviceBox" Grid.Column="1" Classes="setting" AutomationProperties.Name="Audio output device" />
                </Grid>
              </StackPanel>
            </Grid>
          </ScrollViewer>

          <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,14,0,0">
            <StackPanel Spacing="6">
              <TextBlock Classes="hint"
                         Text="Subtitle size and position, hardware decoding and deinterlacing restart the current video for a moment. Preferred languages apply to the next video you open." />
              <TextBlock x:Name="VersionText" Classes="hint" FontFeatures="+tnum" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- Drag a file over the window -->
    <Grid x:Name="DropLayer" IsVisible="False" IsHitTestVisible="False" Background="#B80C0B0A">
      <Border Margin="16" CornerRadius="20" BorderThickness="1.5" BorderBrush="#99F5A524" Background="#0FF5A524">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="24">
          <Viewbox Width="40" Height="40" HorizontalAlignment="Center">
            <Path Classes="icon" Data="{StaticResource IcDrop}" Stroke="{StaticResource Accent}" />
          </Viewbox>
          <TextBlock x:Name="DropTitle" Text="Drop to play" FontSize="28" FontWeight="SemiBold" LetterSpacing="-0.56"
                     HorizontalAlignment="Center" Margin="0,4,0,0" />
          <TextBlock x:Name="DropBody" FontSize="15" LineHeight="22" Foreground="{StaticResource MutedOnVideo}"
                     TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- The overlay window covers the main window's top resize edge; give it back. -->
    <Border x:Name="ResizeTop" Height="4" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNorthSouth" Margin="8,0,8,0" />
    <Border x:Name="ResizeTopLeft" Width="8" Height="8" VerticalAlignment="Top" HorizontalAlignment="Left" Background="Transparent" Cursor="TopLeftCorner" />
    <Border x:Name="ResizeTopRight" Width="8" Height="8" VerticalAlignment="Top" HorizontalAlignment="Right" Background="Transparent" Cursor="TopRightCorner" />
  </Grid>
</UserControl>
