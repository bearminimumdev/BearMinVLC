<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Icons: 24×24 geometry drawn at native size -->
  <Style Selector="Path.icon">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="Stroke" Value="{DynamicResource Text}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="Path.icon.fill">
    <Setter Property="Stroke" Value="{x:Null}" />
    <Setter Property="Fill" Value="{DynamicResource Text}" />
  </Style>

  <!-- Caption glyphs -->
  <Style Selector="Path.cap">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="Stroke" Value="{DynamicResource Muted}" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>
  <Style Selector=".onvideo Path.cap">
    <Setter Property="Stroke" Value="{DynamicResource Text}" />
  </Style>

  <!-- Shared button reset -->
  <Style Selector="Button.icon, Button.caption, Button.row, Button.recent, Button.link, Button.time">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- 44 px icon buttons in the control bar -->
  <Style Selector="Button.icon">
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.icon.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pressed}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.icon.tinted">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Button.icon.tinted:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <!-- Time readout -->
  <Style Selector="Button.time">
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.time:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hover}" />
  </Style>

  <!-- Windows 11 caption buttons: square, flush, red close -->
  <Style Selector="Button.caption">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#14FFFFFF" />
  </Style>
  <Style Selector="Button.caption:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#0AFFFFFF" />
  </Style>
  <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#C42B1C" />
  </Style>
  <Style Selector="Button.caption.close:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#B22A1C" />
  </Style>
  <Style Selector="Button.caption.close:pointerover Path.cap, Button.caption.close:pressed Path.cap">
    <Setter Property="Stroke" Value="White" />
  </Style>

  <!-- Pill actions -->
  <Style Selector="Button.primary, Button.ghost">
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Padding" Value="22,0" />
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Ground}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Ground}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Ground}" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GhostBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hover}" />
    <Setter Property="BorderBrush" Value="#3DFFFFFF" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pressed}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.small">
    <Setter Property="Height" Value="40" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- Menu rows (subtitles, speed, right-click) -->
  <Style Selector="Button.row">
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.row:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.row:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pressed}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>

  <!-- Recent list rows -->
  <Style Selector="Button.recent">
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.recent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.recent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pressed}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>

  <!-- Small text buttons ("Clear", "Start over", "Technical details") -->
  <Style Selector="Button.link">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.link.amber">
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Button.link.amber:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentHover}" />
  </Style>

  <!-- Floating panels -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource Overlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BoxShadow" Value="0 16 40 0 #80000000" />
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="Background" Value="{DynamicResource Overlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #59000000" />
  </Style>
  <Style Selector="Border.kbd">
    <Setter Property="BorderBrush" Value="{DynamicResource GhostBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="6,2" />
  </Style>
  <Style Selector="Border.kbd TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource GeistMono}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Separator.menu">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="4,6" />
    <Setter Property="Background" Value="{DynamicResource Line}" />
  </Style>

  <!-- URL field -->
  <Style Selector="TextBox.url">
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Ground}" />
    <Setter Property="BorderBrush" Value="#1FFFFFFF" />
    <Setter Property="SelectionBrush" Value="#66F5A524" />
    <Setter Property="SelectionForegroundBrush" Value="White" />
    <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="TextBox.url:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Ground}" />
    <Setter Property="BorderBrush" Value="#3DFFFFFF" />
  </Style>
  <Style Selector="TextBox.url:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Ground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>

  <!-- Settings panel -->
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="Margin" Value="0,14,0,2" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Grid.setting">
    <Setter Property="MinHeight" Value="48" />
  </Style>

  <!-- Segmented choice: a recessed track with the picked option raised -->
  <Style Selector="Border.seg">
    <Setter Property="Background" Value="{DynamicResource Ground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.seg">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="11,0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.seg.on">
    <Setter Property="Background" Value="#2E2C29" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.seg.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2E2C29" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>

  <Style Selector="ToggleSwitch">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="OnContent" Value="{x:Null}" />
    <Setter Property="OffContent" Value="{x:Null}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="ComboBox.setting">
    <Setter Property="Width" Value="220" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="{DynamicResource Ground}" />
    <Setter Property="BorderBrush" Value="#1FFFFFFF" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="ComboBox.setting:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource Ground}" />
    <Setter Property="BorderBrush" Value="#3DFFFFFF" />
  </Style>

  <Style Selector="ComboBox /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="34" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="ComboBoxItem:selected">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- Spinner -->
  <Style Selector="Path.spin">
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
